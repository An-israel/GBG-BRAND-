# Copy to .env (never commit .env). Create the token in Shopify admin:
# Settings → Apps and sales channels → Develop apps → Create an app → Admin API scopes (see docs/STORE_SETUP_CHECKLIST.md §Custom app).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxx
GBG_LOCATION_NAME=GBG Bargain Shop, Unit M10
# Used by npm run smoke and the Playwright tests
SMOKE_BASE_URL=https://www.gbgbargainshop.co.uk
PREVIEW_URL=
STOREFRONT_PASSWORD=
