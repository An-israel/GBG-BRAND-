{%- comment -%}
  Shared basket contents for the drawer and the basket page.
  Re-rendered with the Section Rendering API after every change.
{%- endcomment -%}
{%- if cart.item_count > 0 -%}
  <ul class="cart-items" role="list">
    {%- for item in cart.items -%}
      <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
        <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 100, height: 100, alt: '', class: 'cart-item__img' }}
          {%- endif -%}
        </a>
        <div class="cart-item__details">
          <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
          {%- unless item.product.has_only_default_variant -%}
            <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
          {%- endunless -%}
          {%- render 'condition-badge', product: item.product -%}
          {%- if item.product.metafields.custom.collection_only.value == true -%}
            <p class="cart-item__note">{% render 'icon', name: 'store' %} Collection only</p>
          {%- endif -%}
          <div class="cart-item__row">
            <div class="qty" data-qty>
              <button type="button" class="qty__btn" data-qty-change="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
              <input class="qty__input" type="number" inputmode="numeric" min="0"
                {%- if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %} max="{{ item.variant.inventory_quantity }}"{% endif %}
                value="{{ item.quantity }}" aria-label="Quantity of {{ item.product.title | escape }}" data-line-input="{{ forloop.index }}">
              <button type="button" class="qty__btn" data-qty-change="1" aria-label="Increase quantity of {{ item.product.title | escape }}"
                {%- if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' and item.quantity >= item.variant.inventory_quantity %} disabled{% endif %}>{% render 'icon', name: 'plus' %}</button>
            </div>
            <div class="cart-item__price">
              {%- if item.original_line_price > item.final_line_price -%}
                <s class="price__compare">{{ item.original_line_price | money }}</s>
              {%- endif -%}
              <span class="price__regular">{{ item.final_line_price | money }}</span>
            </div>
          </div>
          <button type="button" class="link cart-item__remove" data-remove="{{ forloop.index }}">Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></button>
        </div>
      </li>
    {%- endfor -%}
  </ul>

  <div class="cart-summary">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="cart-summary__discounts" role="list">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li>{% render 'icon', name: 'tag' %} {{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <p class="cart-summary__total">
      <span>Subtotal</span>
      <span class="cart-summary__amount">{{ cart.total_price | money_with_currency }}</span>
    </p>
    <ul class="cart-notes" role="list">
      {%- if settings.claim_free_collection and settings.cart_collection_note != blank -%}
        <li>{% render 'icon', name: 'store' %} {{ settings.cart_collection_note | escape }}</li>
      {%- endif -%}
      {%- if settings.cart_delivery_note != blank -%}
        <li>{% render 'icon', name: 'truck' %} {{ settings.cart_delivery_note | escape }}</li>
      {%- endif -%}
    </ul>
    <form action="{{ routes.cart_url }}" method="post" class="cart-summary__form">
      <button type="submit" name="checkout" class="button button--full button--large" data-track="begin_checkout_click">
        {% render 'icon', name: 'lock' %} Checkout securely
      </button>
    </form>
  </div>
{%- else -%}
  {%- render 'empty-state', heading: 'Your basket is empty', text: 'There are bargains waiting. Start with our best deals or see what has just come in.' -%}
{%- endif -%}
