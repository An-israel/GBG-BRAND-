{%- comment -%}
  ONE source of truth for the shop's navigation. Outputs a flat list that the
  header (desktop + phone), quick links, footer and site map all read, so they
  always agree. Nothing here links to an empty collection or a missing page.

  Output: rows separated by "^^", fields by "~~":  level~~key~~title~~url~~flag
    level 1 = top menu item, 2 = item inside it, 3 = item inside a level-2 item
    flag    = promo (yellow), all (see-everything link) or blank

  Params:
    source – 'gbg' (built-in GBG menu, default) or 'shopify' (use a Shopify menu)
    menu   – the Shopify menu (link_list) when source is 'shopify'

  The built-in menu works the moment the theme is installed – it does not use the
  store's old menus. It reads these collection handles (created by setup-store):
{%- endcomment -%}
{%- liquid
  assign out = ''
  assign generic = 'all,frontpage,bargains,new-arrivals,under-5,clearance,last-chance,best-sellers' | split: ','

  if source == 'shopify' and menu != blank and menu.links.size > 0
    for link in menu.links
      if link.type == 'collection_link' and link.object.products_count == 0
        continue
      endif
      if link.type == 'page_link' and link.object == blank
        continue
      endif
      assign flag = ''
      if link.handle contains 'clearance' or link.handle contains 'deal' or link.handle contains 'bargain'
        assign flag = 'promo'
      endif
      assign out = out | append: '^^1~~m' | append: forloop.index | append: '~~' | append: link.title | append: '~~' | append: link.url | append: '~~' | append: flag
      for child in link.links
        if child.type == 'collection_link' and child.object.products_count == 0
          continue
        endif
        if child.type == 'page_link' and child.object == blank
          continue
        endif
        assign out = out | append: '^^2~~m' | append: forloop.parentloop.index | append: '~~' | append: child.title | append: '~~' | append: child.url | append: '~~'
        for grandchild in child.links
          if grandchild.type == 'collection_link' and grandchild.object.products_count == 0
            continue
          endif
          if grandchild.type == 'page_link' and grandchild.object == blank
            continue
          endif
          assign out = out | append: '^^3~~m~~' | append: grandchild.title | append: '~~' | append: grandchild.url | append: '~~'
        endfor
      endfor
    endfor
  else

  # ---------- Built-in GBG menu ----------
  # Categories: handle | menu label | sub-collection handles
  assign cats = 'bags-accessories|Bags & Accessories|handbags,backpacks,purses,travel;shoes|Shoes|womens-shoes,mens-shoes,kids-shoes;jewellery-watches|Jewellery & Watches|earrings,necklaces,bracelets,watches;fashion|Fashion|womens-fashion,mens-fashion,kids-fashion;home-kitchen|Home & Kitchen|cookware,storage,household-essentials;electronics-gadgets|Electronics|speakers,small-electronics,tech-accessories;beauty-personal-care|Beauty|' | split: ';'

  assign shop_rows = ''
  assign shown_cats = 0
  for cat in cats
    assign parts = cat | split: '|'
    assign c = collections[parts[0]]
    if c.products_count > 0
      assign shown_cats = shown_cats | plus: 1
      assign shop_rows = shop_rows | append: '^^2~~shop~~' | append: parts[1] | append: '~~' | append: c.url | append: '~~'
      assign subs = parts[2] | split: ','
      for h in subs
        assign sc = collections[h]
        if sc.products_count > 0
          assign shop_rows = shop_rows | append: '^^3~~' | append: parts[0] | append: '~~' | append: sc.title | append: '~~' | append: sc.url | append: '~~'
        endif
      endfor
    endif
  endfor

  # The GBG categories haven't been created yet (fresh store, or still the old DBS
  # collections): list whatever real collections have products instead.
  if shown_cats == 0
    for c in collections
      if c.products_count == 0 or generic contains c.handle
        continue
      endif
      assign shop_rows = shop_rows | append: '^^2~~shop~~' | append: c.title | append: '~~' | append: c.url | append: '~~'
      assign shown_cats = shown_cats | plus: 1
      if shown_cats >= 8
        break
      endif
    endfor
  endif

  assign out = out | append: '^^1~~shop~~Shop~~' | append: routes.all_products_collection_url | append: '~~' | append: shop_rows
  assign out = out | append: '^^2~~shop~~All products~~' | append: routes.all_products_collection_url | append: '~~all'

  assign na = collections['new-arrivals']
  if na.products_count > 0
    assign out = out | append: '^^1~~new~~New in~~' | append: na.url | append: '~~'
  endif

  assign deals = 'under-5|Under £5;clearance|Clearance;last-chance|Last chance;bargains|Best bargains' | split: ';'
  assign deal_rows = ''
  assign first_deal = ''
  for d in deals
    assign parts = d | split: '|'
    assign dc = collections[parts[0]]
    if dc.products_count > 0
      if first_deal == blank
        assign first_deal = dc.url
      endif
      assign deal_rows = deal_rows | append: '^^2~~deals~~' | append: parts[1] | append: '~~' | append: dc.url | append: '~~'
    endif
  endfor
  if deal_rows != blank
    assign out = out | append: '^^1~~deals~~Deals~~' | append: first_deal | append: '~~promo' | append: deal_rows
  endif

  assign visit_url = routes.root_url | append: '#visit'
  if pages['visit-our-shop'].url != blank
    assign visit_url = pages['visit-our-shop'].url
  endif
  assign out = out | append: '^^1~~visit~~Visit us~~' | append: visit_url | append: '~~'

  # Help: only pages and policies that exist, plus the site map and phone (never empty).
  assign help_rows = ''
  assign help_url = routes.collections_url
  if pages['contact'].url != blank
    assign help_rows = help_rows | append: '^^2~~help~~Contact us~~' | append: pages['contact'].url | append: '~~'
    assign help_url = pages['contact'].url
  endif
  if pages['faqs'].url != blank
    assign help_rows = help_rows | append: '^^2~~help~~FAQs~~' | append: pages['faqs'].url | append: '~~'
  endif
  if pages['click-and-collect'].url != blank
    assign help_rows = help_rows | append: '^^2~~help~~Click & Collect~~' | append: pages['click-and-collect'].url | append: '~~'
  endif
  if pages['shipping-delivery'].url != blank
    assign help_rows = help_rows | append: '^^2~~help~~Delivery~~' | append: pages['shipping-delivery'].url | append: '~~'
  elsif shop.shipping_policy.url != blank
    assign help_rows = help_rows | append: '^^2~~help~~Delivery~~' | append: shop.shipping_policy.url | append: '~~'
  endif
  if shop.refund_policy.url != blank
    assign help_rows = help_rows | append: '^^2~~help~~Returns & refunds~~' | append: shop.refund_policy.url | append: '~~'
  endif
  if pages['about'].url != blank
    assign help_rows = help_rows | append: '^^2~~help~~About us~~' | append: pages['about'].url | append: '~~'
  endif
  assign help_rows = help_rows | append: '^^2~~help~~Site map~~' | append: routes.collections_url | append: '~~'
  if settings.phone_international != blank
    assign help_rows = help_rows | append: '^^2~~help~~Call ' | append: settings.phone | append: '~~tel:+' | append: settings.phone_international | append: '~~'
  endif
  assign out = out | append: '^^1~~help~~Help~~' | append: help_url | append: '~~' | append: help_rows
  endif

  echo out
-%}
