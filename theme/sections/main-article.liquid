<article class="section">
  <div class="container container--narrow">
    <h1 class="page-title">{{ article.title | escape }}</h1>
    <p class="article__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time></p>
    {%- if article.image -%}
      {{ article.image | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 800px) 760px, 100vw', class: 'article__img' }}
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>
{% schema %}
{ "name": "Blog post", "class": "section-main-article", "settings": [] }
{% endschema %}
