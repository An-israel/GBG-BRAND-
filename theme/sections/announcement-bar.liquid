{%- comment -%}
  Yellow announcement bar with navy text. Each message can have an optional
  end date – it hides automatically after that date (checked on the server
  and again in the browser, because pages can be cached).
{%- endcomment -%}
{%- assign today = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- capture messages -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign expired = false
      if block.settings.end_date != blank
        assign end_num = block.settings.end_date | remove: '-' | plus: 0
        if end_num > 0 and today > end_num
          assign expired = true
        endif
      endif
    -%}
    {%- if block.settings.text != blank and expired == false -%}
      <p class="announcement__msg" {{ block.shopify_attributes }}{% if block.settings.end_date != blank %} data-end="{{ block.settings.end_date | escape }}"{% endif %}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text | escape }} {% render 'icon', name: 'arrow' %}</a>
        {%- else -%}
          {{ block.settings.text | escape }}
        {%- endif -%}
      </p>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if messages != blank -%}
  <div class="announcement" role="region" aria-label="Announcement">
    <div class="container announcement__inner">{{ messages }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Visit our Liverpool shop – Unit M10, Stanley Meat Market, Prescot Road",
          "info": "Only genuine messages. No unverified discount claims."
        },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "text",
          "id": "end_date",
          "label": "End date (optional)",
          "info": "Format YYYY-MM-DD. The message hides automatically after this date."
        }
      ]
    }
  ],
  "presets": [{ "name": "Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
