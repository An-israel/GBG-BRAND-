{%- comment -%} Category tiles. A tile only shows when its collection has products. {%- endcomment -%}
{%- assign real_tiles = 0 -%}
{%- capture tiles -%}
  {%- for block in section.blocks -%}
    {%- assign c = block.settings.collection -%}
    {%- if c != blank and c.products_count > 0 -%}
      {%- assign real_tiles = real_tiles | plus: 1 -%}
      {%- assign tile_image = block.settings.image | default: c.featured_image | default: c.products.first.featured_media.preview_image -%}
      <li class="category-tile reveal" {{ block.shopify_attributes }}>
        <a href="{{ c.url }}" class="category-tile__link">
          <span class="category-tile__media">
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 600 | image_tag:
                widths: '160, 240, 320, 480, 600',
                sizes: '(min-width: 990px) 15vw, (min-width: 750px) 30vw, 45vw',
                loading: 'lazy',
                alt: '',
                class: 'category-tile__img'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-tile__img placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="category-tile__label">{{ block.settings.label | default: c.title | escape }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      </li>
    {%- elsif request.design_mode -%}
      <li class="category-tile category-tile--empty" {{ block.shopify_attributes }}>
        <p class="placeholder-note">Hidden on the live site: choose a collection that has products.</p>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- comment -%}
  None of the chosen collections exist yet (e.g. a fresh store): show the shop's real
  categories from the menu instead, each with a real product photo.
{%- endcomment -%}
{%- if real_tiles == 0 -%}
  {%- capture nav_raw -%}{%- render 'nav-tree', source: 'gbg' -%}{%- endcapture -%}
  {%- assign nav_rows = nav_raw | strip | remove_first: '^^' | split: '^^' -%}
  {%- capture tiles -%}
    {%- for row in nav_rows -%}
      {%- assign f = row | split: '~~' -%}
      {%- unless f[0] == '2' and f[1] == 'shop' and f[4] != 'all' -%}{%- continue -%}{%- endunless -%}
      {%- assign handle = f[3] | split: '/collections/' | last | split: '?' | first -%}
      {%- assign c = collections[handle] -%}
      {%- assign tile_image = c.featured_image | default: c.products.first.featured_media.preview_image -%}
      <li class="category-tile reveal">
        <a href="{{ f[3] }}" class="category-tile__link">
          <span class="category-tile__media">
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 600 | image_tag: widths: '160, 240, 320, 480, 600', sizes: '(min-width: 990px) 15vw, (min-width: 750px) 30vw, 45vw', loading: 'lazy', alt: '', class: 'category-tile__img' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'category-tile__img placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="category-tile__label">{{ f[2] | escape }} {% render 'icon', name: 'arrow' %}</span>
        </a>
      </li>
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}
{%- if tiles != blank -%}
  <section class="section section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="category-grid" role="list">{{ tiles }}</ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Category grid",
  "class": "section-category-grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }],
      "default": "white"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Defaults to the collection image. Real GBG stock only." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        { "type": "category" }, { "type": "category" }, { "type": "category" },
        { "type": "category" }, { "type": "category" }, { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
