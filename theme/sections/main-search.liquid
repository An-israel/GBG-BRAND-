{%- paginate search.results by 24 -%}
<div class="section search-page">
  <div class="container">
    <h1 class="page-title">{% if search.performed %}Results for “{{ search.terms | escape }}”{% else %}Search{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-inline search-inline--large">
      <label for="SearchPage" class="visually-hidden">Search the shop</label>
      <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search bags, shoes, homeware…" class="input">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button">{% render 'icon', name: 'search' %} Search</button>
    </form>

    {%- if search.performed -%}
      <div class="collection__layout{% if search.filters.size > 0 %} collection__layout--filters{% endif %}">
      {%- render 'facets-panel', results: search, url: routes.search_url, terms: search.terms -%}
      <div class="collection__results">
      {%- if search.results_count > 0 or search.filters.size > 0 -%}
        <div class="collection__toolbar">
          <p class="collection__count" role="status">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</p>
          {%- render 'facets', results: search, url: routes.search_url, terms: search.terms -%}
        </div>
      {%- endif -%}
      {%- if search.results_count > 0 -%}
        <ul class="product-grid" role="list" id="ProductGrid-{{ section.id }}">
          {%- for item in search.results -%}
            <li class="product-grid__item">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {%- render 'product-card', product: item, heading_level: 'h2' -%}
                {%- else -%}
                  <article class="card card--text">
                    <h2 class="card__title"><a href="{{ item.url }}" class="card__link">{{ item.title | escape }}</a></h2>
                    <p class="card__excerpt">{{ item.content | strip_html | truncatewords: 20 }}</p>
                  </article>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if paginate.next -%}
          <div class="load-more" data-load-more-wrap>
            <a href="{{ paginate.next.url }}" class="button button--secondary button--large" data-load-more data-grid="ProductGrid-{{ section.id }}" data-section="{{ section.id }}">Load more</a>
          </div>
        {%- endif -%}
      {%- else -%}
        {%- render 'empty-state', heading: 'No results found', text: 'Check the spelling, try a simpler word like “bag” or “mug”, or browse our bargains.' -%}
      {%- endif -%}
      </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search results",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
