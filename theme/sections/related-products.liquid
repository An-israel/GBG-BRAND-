{%- comment -%}
  "You may also like" – Shopify product recommendations, loaded after the
  page so it never slows the first paint. Falls back to nothing if empty.
{%- endcomment -%}
<product-recommendations class="section related" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>
      <ul class="product-grid product-grid--row" role="list">
        {%- for product in recommendations.products -%}
          {%- if product.available -%}<li>{%- render 'product-card', product: product -%}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "You may also like",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
