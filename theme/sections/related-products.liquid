{%- comment -%}
  "You may also like" – products from the SAME collection as this product
  (brief §6.3). Uses the collection the shopper came from, otherwise the
  product's most specific category collection (promo collections such as
  Clearance or New Arrivals are skipped). Sold-out items are left out.
  If the collection has too few other products, Shopify's own
  recommendations are loaded instead (after the page, so it never slows it).
{%- endcomment -%}
{%- liquid
  assign generic = 'all,frontpage,bargains,new-arrivals,under-5,clearance,last-chance' | split: ','
  assign source = nil
  if section.settings.source == 'collection'
    if collection and collection.handle != 'all'
      assign source = collection
    else
      # Most specific category that still has at least 2 other products;
      # otherwise the biggest category the product is in.
      for c in product.collections
        if generic contains c.handle or c.products_count < 3
          continue
        endif
        if source == nil or c.products_count < source.products_count
          assign source = c
        endif
      endfor
      if source == nil
        for c in product.collections
          if generic contains c.handle
            continue
          endif
          if source == nil or c.products_count > source.products_count
            assign source = c
          endif
        endfor
      endif
    endif
  endif
  assign shown = 0
-%}
{%- capture items -%}
  {%- if source -%}
    {%- for p in source.products limit: 24 -%}
      {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
      <li>{%- render 'product-card', product: p -%}</li>
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if shown >= 2 -%}
  <section class="section related" aria-labelledby="Title-{{ section.id }}">
    <div class="container">
      <div class="section-head section-head--split">
        <h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <a href="{{ source.url }}" class="link-arrow">More in {{ source.title | escape }} {% render 'icon', name: 'arrow' %}</a>
      </div>
      <ul class="product-grid product-grid--row" role="list">{{ items }}</ul>
    </div>
  </section>
{%- else -%}
  <product-recommendations class="section related" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="container">
        <div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>
        <ul class="product-grid product-grid--row" role="list">
          {%- for p in recommendations.products -%}
            {%- if p.available -%}<li>{%- render 'product-card', product: p -%}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </product-recommendations>
{%- endif -%}

{% schema %}
{
  "name": "You may also like",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "select",
      "id": "source",
      "label": "Products from",
      "options": [
        { "value": "collection", "label": "The same collection" },
        { "value": "recommendations", "label": "Shopify recommendations" }
      ],
      "default": "collection"
    },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
