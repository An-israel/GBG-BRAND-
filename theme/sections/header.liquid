{%- liquid
  assign cart_url = routes.cart_url
-%}
{%- comment -%}
  Navigation comes from snippets/nav-tree.liquid (one list for the top menu, phone
  menu, quick links, footer and site map). By default it is the built-in GBG menu,
  which never shows the store's old menus, empty collections or missing pages.
{%- endcomment -%}
{%- capture nav_raw -%}{%- render 'nav-tree', source: section.settings.nav_source, menu: section.settings.menu -%}{%- endcapture -%}
{%- assign nav_rows = nav_raw | split: '^^' -%}
{%- comment -%}
  Rows start with 1, 2 or 3; anything else (e.g. a hidden Liquid error inside the snippet) is ignored
  by every menu loop, and shown here in the theme editor only so it can be fixed.
{%- endcomment -%}
{%- assign nav_head = nav_rows.first | strip -%}
{%- if request.design_mode and nav_head != blank -%}
  <p class="placeholder-note" style="margin:0;border-radius:0">Menu note (only visible in the editor): {{ nav_head | escape | truncate: 300 }}</p>
{%- endif -%}
<header class="header" data-header>
  <div class="container header__row">
    <button type="button" class="header__menu-btn" aria-label="Open menu" aria-haspopup="dialog" aria-controls="MenuSheet" data-open-dialog="MenuSheet">
      {%- render 'icon', name: 'menu' -%}<span class="header__menu-label" aria-hidden="true">Menu</span>
    </button>

    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if settings.logo != blank -%}
          {%- assign logo_h = settings.logo_width | divided_by: settings.logo.aspect_ratio | round -%}
          {%- assign logo_sizes = '(min-width: 990px) ' | append: settings.logo_width | append: 'px, 120px' -%}
          {{ settings.logo | image_url: width: 520 | image_tag:
            widths: '160, 260, 390, 520',
            sizes: logo_sizes,
            width: settings.logo_width,
            height: logo_h,
            alt: shop.name,
            loading: 'eager',
            class: 'header__logo-img'
          }}
        {%- else -%}
          <span class="logo-text logo-text--stacked">
            <span class="logo-text__name"><span class="logo-text__gbg">GBG</span> <span class="logo-text__bargain">Bargain Shop</span></span>
            {%- if section.settings.show_tagline -%}<span class="logo-text__tagline">{{ section.settings.tagline | escape }}</span>{%- endif -%}
          </span>
        {%- endif -%}
      </a>
    </div>

    <predictive-search class="header__search" data-predictive-search>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <label for="HeaderSearch" class="visually-hidden">Search products</label>
        <input id="HeaderSearch" class="search-form__input" type="search" name="q" value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off"
          role="combobox" aria-expanded="false" aria-owns="PredictiveResults" aria-controls="PredictiveResults" aria-haspopup="listbox" aria-autocomplete="list">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="search-form__btn" aria-label="Search">{% render 'icon', name: 'search' %}</button>
        <div class="predictive" id="PredictiveResults" data-predictive-results hidden></div>
      </form>
    </predictive-search>

    {%- liquid
      assign store_url = routes.root_url | append: '#visit'
      if pages['visit-our-shop'].url != blank
        assign store_url = pages['visit-our-shop'].url
      endif
    -%}
    <div class="header__icons">
      <a href="{{ store_url }}" class="header__icon header__store">
        {%- render 'icon', name: 'pin' -%}<span class="header__icon-label">Our store</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__icon header__account">
          {%- render 'icon', name: 'account' -%}<span class="header__icon-label">{% if customer %}Account{% else %}Sign in{% endif %}</span>
        </a>
      {%- endif -%}
      <a href="{{ cart_url }}" class="header__icon header__cart" data-cart-toggle aria-label="Basket, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}" aria-haspopup="dialog">
        {%- render 'icon', name: 'basket' -%}<span class="header__icon-label" aria-hidden="true">Basket</span>
        <span class="header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- comment -%} ---------- Computer: top menu ---------- {%- endcomment -%}
  <nav class="header__nav" aria-label="Main">
    <ul class="container nav" role="list">
      {%- for row in nav_rows -%}
        {%- assign f = row | split: '~~' -%}
        {%- if f[0] != '1' or f[4] == 'secondary' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign kids = 0
          assign mega = false
          for r2 in nav_rows offset: forloop.index
            assign g = r2 | split: '~~'
            if g[0] == '1'
              break
            endif
            assign kids = kids | plus: 1
            if g[0] == '3'
              assign mega = true
            endif
          endfor
          assign is_active = false
          if request.path == f[3] or request.path contains f[3] and f[3] != '/'
            assign is_active = true
          endif
        -%}
        {%- if kids > 0 -%}
          <li class="nav__item nav__item--parent">
            <details class="nav__details" data-nav-details>
              <summary class="nav__link{% if f[4] == 'promo' %} nav__link--promo{% endif %}">{{ f[2] | escape }} {% render 'icon', name: 'chevron' %}</summary>
              <div class="nav__panel{% if mega %} nav__panel--mega{% endif %}">
                {%- if mega -%}
                  <div class="container mega-wrap">
                    <ul class="mega" role="list">
                      {%- assign base = forloop.index -%}
                      {%- for r2 in nav_rows offset: base -%}
                        {%- assign g = r2 | split: '~~' -%}
                        {%- if g[0] == '1' -%}{%- break -%}{%- endif -%}
                        {%- if g[0] != '2' -%}{%- continue -%}{%- endif -%}
                        {%- if g[4] == 'all' -%}
                          <li class="mega__col mega__col--all"><a href="{{ g[3] }}" class="mega__all">{{ g[2] | escape }} {% render 'icon', name: 'arrow' %}</a></li>
                        {%- else -%}
                          {%- assign sub_offset = base | plus: forloop.index -%}
                          <li class="mega__col">
                            <a href="{{ g[3] }}" class="mega__heading">{{ g[2] | escape }}</a>
                            <ul class="mega__list" role="list">
                              {%- for r3 in nav_rows offset: sub_offset -%}
                                {%- assign h = r3 | split: '~~' -%}
                                {%- if h[0] != '3' -%}{%- break -%}{%- endif -%}
                                <li><a href="{{ h[3] }}" class="mega__link">{{ h[2] | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- else -%}
                  <ul class="dropdown" role="list">
                    {%- for r2 in nav_rows offset: forloop.index -%}
                      {%- assign g = r2 | split: '~~' -%}
                      {%- if g[0] == '1' -%}{%- break -%}{%- endif -%}
                      <li class="dropdown__item"><a href="{{ g[3] }}" class="dropdown__link">{{ g[2] | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </details>
          </li>
        {%- else -%}
          <li class="nav__item">
            <a href="{{ f[3] }}" class="nav__link{% if f[4] == 'promo' %} nav__link--promo{% endif %}{% if is_active %} nav__link--active{% endif %}"{% if is_active %} aria-current="page"{% endif %}>{{ f[2] | escape }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>

  {%- comment -%} ---------- Phone: quick links under the search bar ---------- {%- endcomment -%}
  {%- if section.settings.show_quick_links -%}
    <nav class="quick-links" aria-label="Quick links">
      <ul class="quick-links__list" role="list">
        {%- for row in nav_rows -%}
          {%- assign f = row | split: '~~' -%}
          {%- if f[0] == '1' and f[1] != 'shop' and f[1] != 'help' -%}
            <li><a href="{{ f[3] }}" class="quick-links__chip{% if f[4] == 'promo' %} quick-links__chip--promo{% endif %}">{{ f[2] | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- for row in nav_rows -%}
          {%- assign f = row | split: '~~' -%}
          {%- if f[0] == '2' and f[1] == 'shop' and f[4] != 'all' -%}
            <li><a href="{{ f[3] }}" class="quick-links__chip">{{ f[2] | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

{%- comment -%} ---------- Phone menu (bottom sheet) ---------- {%- endcomment -%}
<dialog class="sheet" id="MenuSheet" aria-label="Menu" data-menu-sheet>
  <div class="sheet__inner">
    <div class="sheet__handle" aria-hidden="true"></div>
    <div class="sheet__header">
      <p class="sheet__title">Menu</p>
      <button type="button" class="icon-button" data-close-dialog aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="sheet__scroll">
      <form action="{{ routes.search_url }}" method="get" role="search" class="sheet__search">
        <label for="SheetSearch" class="visually-hidden">Search products</label>
        <input id="SheetSearch" class="input" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="search-form__btn" aria-label="Search">{% render 'icon', name: 'search' %}</button>
      </form>

      {%- comment -%} Highlights first: New in / Deals / Visit us as big buttons {%- endcomment -%}
      <ul class="sheet__highlights" role="list">
        {%- for row in nav_rows -%}
          {%- assign f = row | split: '~~' -%}
          {%- if f[0] == '1' and f[1] != 'shop' and f[1] != 'help' -%}
            <li><a href="{{ f[3] }}" class="sheet__highlight{% if f[4] == 'promo' %} sheet__highlight--promo{% endif %}">
              {%- case f[1] -%}
                {%- when 'visit' -%}{% render 'icon', name: 'pin' %}
                {%- when 'clearance' -%}{% render 'icon', name: 'tag' %}
                {%- when 'new' -%}{% render 'icon', name: 'plus' %}
                {%- else -%}{% render 'icon', name: 'arrow' %}
              {%- endcase -%}
              <span>{{ f[2] | escape }}</span></a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <p class="sheet__heading">Shop by category</p>
      <ul class="sheet__list" role="list">
        {%- for row in nav_rows -%}
          {%- assign f = row | split: '~~' -%}
          {%- unless f[0] == '2' and f[1] == 'shop' -%}{%- continue -%}{%- endunless -%}
          {%- liquid
            assign subs = 0
            for r2 in nav_rows offset: forloop.index
              assign g = r2 | split: '~~'
              if g[0] != '3'
                break
              endif
              assign subs = subs | plus: 1
            endfor
          -%}
          <li>
            {%- if subs > 0 -%}
              <details class="sheet__details">
                <summary class="sheet__link">{{ f[2] | escape }} {% render 'icon', name: 'chevron' %}</summary>
                <ul class="sheet__sublist" role="list">
                  <li><a class="sheet__sublink sheet__sublink--all" href="{{ f[3] }}">All {{ f[2] | escape }}</a></li>
                  {%- for r2 in nav_rows offset: forloop.index -%}
                    {%- assign g = r2 | split: '~~' -%}
                    {%- if g[0] != '3' -%}{%- break -%}{%- endif -%}
                    <li><a class="sheet__sublink" href="{{ g[3] }}">{{ g[2] | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a class="sheet__link{% if f[4] == 'all' %} sheet__link--all{% endif %}" href="{{ f[3] }}">{{ f[2] | escape }} {% render 'icon', name: 'arrow' %}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%} Other menus with items inside (Deals list, Help, or a Shopify menu) {%- endcomment -%}
      {%- for row in nav_rows -%}
        {%- assign f = row | split: '~~' -%}
        {%- if f[0] != '1' or f[1] == 'shop' -%}{%- continue -%}{%- endif -%}
        {%- assign next = nav_rows[forloop.index] | split: '~~' -%}
        {%- if next[0] != '2' -%}{%- continue -%}{%- endif -%}
        <p class="sheet__heading">{{ f[2] | escape }}</p>
        <ul class="sheet__list" role="list">
          {%- for r2 in nav_rows offset: forloop.index -%}
            {%- assign g = r2 | split: '~~' -%}
            {%- if g[0] == '1' -%}{%- break -%}{%- endif -%}
            {%- if g[0] == '2' -%}<li><a class="sheet__link sheet__link--small" href="{{ g[3] }}">{{ g[2] | escape }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
    <div class="sheet__footer">
      <a href="tel:+{{ settings.phone_international }}" class="sheet__contact">{% render 'icon', name: 'phone' %} {{ settings.phone | escape }}</a>
      {%- if settings.whatsapp_enabled -%}
        <a href="https://wa.me/{{ settings.phone_international }}" class="sheet__contact" target="_blank" rel="noopener" data-track="whatsapp_click">{% render 'icon', name: 'whatsapp' %} WhatsApp us</a>
      {%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="sheet__contact">{% render 'icon', name: 'account' %} {% if customer %}Your account{% else %}Log in{% endif %}</a>
      {%- endif -%}
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "select",
      "id": "nav_source",
      "label": "Menu",
      "options": [
        { "value": "gbg", "label": "Built-in GBG menu (recommended)" },
        { "value": "shopify", "label": "A Shopify menu (choose below)" }
      ],
      "default": "gbg",
      "info": "The built-in menu is: Shop (all categories and deals) · New Arrivals · Clearance · Visit Us. Help is in the footer and phone menu. It only shows categories that have products and pages that exist, and updates itself."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shopify menu",
      "info": "Only used when Menu is set to \"A Shopify menu\". Edit it in Online Store → Navigation."
    },
    { "type": "checkbox", "id": "show_tagline", "label": "Show tagline under the text logo", "default": true, "info": "Only used until a logo image is uploaded." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Big bargains. Small prices." },
    {
      "type": "checkbox",
      "id": "show_quick_links",
      "label": "Show quick links under the search bar on phones",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search bags, shoes, homeware…"
    },
    {
      "type": "paragraph",
      "content": "The logo is changed in Theme settings (gear icon, bottom left) → Brand and logo."
    }
  ]
}
{% endschema %}
