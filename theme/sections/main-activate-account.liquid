<div class="section account">
  <div class="container container--form">
    <h1 class="page-title">Activate your account</h1>
    {%- form 'activate_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ActPassword">Password</label><input class="input" type="password" name="customer[password]" id="ActPassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ActConfirm">Confirm password</label><input class="input" type="password" name="customer[password_confirmation]" id="ActConfirm" autocomplete="new-password" required></div>
      <button type="submit" class="button button--full">Activate account</button>
      <button type="submit" name="decline" class="button button--secondary button--full">Decline invitation</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Activate account", "class": "section-activate", "settings": [] }
{% endschema %}
