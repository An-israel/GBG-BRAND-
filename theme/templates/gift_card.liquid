{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Your {{ gift_card.balance | money }} gift card – {{ shop.name }}</title>
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section">
      <div class="container container--form gift-card">
        <p class="password__logo"><span class="logo-text"><span class="logo-text__mark">GBG</span><span class="logo-text__word">Bargain Shop</span></span></p>
        <h1 class="page-title">Your gift card</h1>
        <p class="price price--large"><span class="price__regular">{{ gift_card.balance | money }}</span></p>
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="form-message form-message--error">This gift card is no longer valid.</p>
        {%- elsif gift_card.expires_on -%}
          <p>Expires on {{ gift_card.expires_on | date: '%-d %B %Y' }}</p>
        {%- endif -%}
        <p>Gift card code:</p>
        <p class="gift-card__code"><strong>{{ gift_card.code | format_code }}</strong></p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <p><a href="{{ shop.url }}" class="button">Start shopping</a> <button type="button" class="button button--secondary" onclick="window.print()">Print</button></p>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
