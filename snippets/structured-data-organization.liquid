{%- liquid
  assign same_as = ''
  if settings.social_instagram != blank
    assign same_as = same_as | append: settings.social_instagram | append: '|||'
  endif
  if settings.social_tiktok != blank
    assign same_as = same_as | append: settings.social_tiktok | append: '|||'
  endif
  if settings.social_facebook != blank
    assign same_as = same_as | append: settings.social_facebook | append: '|||'
  endif
  assign same_as_list = same_as | split: '|||'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ settings.shop_display_name | default: shop.name | json }},
    {%- if settings.legal_entity != blank %}"legalName": {{ settings.legal_entity | json }},{% endif %}
    {%- if settings.logo %}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{% endif %}
    {%- if same_as_list.size > 0 %}"sameAs": {{ same_as_list | json }},{% endif %}
    "url": {{ request.origin | append: routes.root_url | json }}
  }
</script>
