{%- assign email_title = 'Your refund' -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ email_title }}</title>
</head>
<body style="margin:0;padding:0;background:#F7F7F5;font-family:Inter,Arial,Helvetica,sans-serif;color:#16181D;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F7F5;">
    <tr><td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:10px;overflow:hidden;">
        <tr><td style="background:#0B1F3A;padding:20px 28px;border-bottom:4px solid #C9A227;">
          {%- if shop.email_logo_url != blank -%}
            <img src="{{ shop.email_logo_url }}" alt="GBG Bargain Shop" width="{{ shop.email_logo_width | default: 150 }}" style="display:block;border:0;max-width:200px;height:auto;">
          {%- else -%}
            <span style="display:inline-block;background:#C9A227;color:#0B1F3A;font:800 20px Arial,sans-serif;padding:6px 8px;border-radius:4px;">GBG</span>
            <span style="color:#ffffff;font:700 18px Arial,sans-serif;padding-left:6px;">Bargain Shop</span>
          {%- endif -%}
        </td></tr>
        <tr><td style="padding:28px;">
<h1 style="margin:0 0 12px;font:800 26px/1.15 Arial,Helvetica,sans-serif;color:#0B1F3A;">We've refunded you</h1>
<p style="margin:0 0 16px;font-size:16px;line-height:1.55;color:#16181D;">We've refunded <strong>{{ amount | money }}</strong> for order <strong>{{ order_name }}</strong> to your original payment method.
It can take 3–10 working days to show on your statement, depending on your bank.</p>
{%- if refund_line_items.size > 0 -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:8px 0 16px;border-top:1px solid #E3E5EA;">
  {%- for item in refund_line_items -%}
  <tr><td style="padding:12px 0;border-bottom:1px solid #E3E5EA;font-size:15px;">{{ item.line_item.title }} × {{ item.quantity }}</td></tr>
  {%- endfor -%}
</table>
{%- endif -%}
<p style="margin:0 0 24px;"><a href="{{ order_status_url }}" style="display:inline-block;background:#0B1F3A;color:#ffffff;text-decoration:none;font-weight:700;padding:14px 26px;border-radius:999px;font-size:16px;">View your order</a></p>
<p style="margin:0;font-size:14px;color:#5D6470;">Questions about your refund? Call 07344 670317.</p>

        </td></tr>
        <tr><td style="background:#0B1F3A;color:#DCE3EE;padding:22px 28px;font-size:13px;line-height:1.6;">
          <strong style="color:#ffffff;">GBG Bargain Shop</strong><br>
          Unit M10, Stanley Meat Market, Prescot Road, Liverpool, L13 3AS<br>
          Phone <a href="tel:+447344670317" style="color:#ffffff;">07344 670317</a>
          {%- if shop.email %} · <a href="mailto:{{ shop.email }}" style="color:#ffffff;">{{ shop.email }}</a>{% endif %}<br>
          <a href="{{ shop.url }}" style="color:#FFD60A;">gbgbargainshop.co.uk</a>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
