<div class="password">
  <div class="container container--narrow password__inner">
    <p class="password__logo"><span class="logo-text logo-text--stacked"><span class="logo-text__name"><span class="logo-text__gbg">GBG</span> <span class="logo-text__bargain">Bargain Shop</span></span><span class="logo-text__tagline">Big bargains. Small prices.</span></span></p>
    <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message | escape }}</p>{%- endif -%}
    <p>Visit us at {{ settings.address_line_1 | escape }}, {{ settings.address_line_2 | escape }}, {{ settings.address_city | escape }} {{ settings.address_postcode | escape }}.</p>
    <details class="password__login">
      <summary>Staff: enter password</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">That password is not right.</p>{%- endif -%}
        <label for="Password" class="visually-hidden">Password</label>
        <input class="input" type="password" name="password" id="Password" autocomplete="current-password" placeholder="Password">
        <button type="submit" class="button button--yellow">Enter</button>
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Big bargains. Small prices. Coming soon online." }]
}
{% endschema %}
