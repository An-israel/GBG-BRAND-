<section class="section newsletter section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container container--narrow newsletter__inner reveal">
    <h2 class="section-title section-title--center" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="newsletter__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- render 'newsletter-form', id: section.id -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first to the bargains" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New stock arrives every week. Get an email when the best finds land – no spam." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }, { "value": "gold-soft", "label": "Gold soft" }],
      "default": "gold-soft"
    }
  ],
  "presets": [{ "name": "Newsletter signup" }]
}
{% endschema %}
