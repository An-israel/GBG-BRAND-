<section class="section section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container">
    <div class="section-head"><h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <ul class="photo-grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <figure>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', class: 'photo-grid__img' }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'photo-grid__img placeholder-svg' }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop photos",
  "class": "section-photo-gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the shop" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }],
      "default": "paper"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Real photo of the shop" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "Shop photos", "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }] }]
}
{% endschema %}
