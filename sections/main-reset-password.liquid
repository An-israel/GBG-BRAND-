<div class="section account">
  <div class="container container--form">
    <h1 class="page-title">Choose a new password</h1>
    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">New password</label><input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetConfirm">Confirm password</label><input class="input" type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password" required></div>
      <button type="submit" class="button button--full">Reset password</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Reset password", "class": "section-reset", "settings": [] }
{% endschema %}
