{%- comment -%} Tabbed product rows from live collections (e.g. Best Bargains / New Arrivals). {%- endcomment -%}
{%- liquid
  assign tabs = ''
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign tabs = tabs | append: block.id | append: ','
    endif
  endfor
  assign tab_ids = tabs | split: ','
  assign limit = section.settings.products_to_show
-%}
{%- if tab_ids.size > 0 -%}
<section class="section section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--split">
      <h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if tab_ids.size > 1 -%}
        <gbg-tabs class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- unless tab_ids contains block.id -%}{%- continue -%}{%- endunless -%}
            <button type="button" role="tab" class="tabs__tab" id="Tab-{{ block.id }}" aria-controls="Panel-{{ block.id }}"
              aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}" {% unless tab_index == 0 %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.collection.title | escape }}
            </button>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endfor -%}
        </gbg-tabs>
      {%- endif -%}
    </div>

    {%- assign panel_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- unless tab_ids contains block.id -%}{%- continue -%}{%- endunless -%}
      {%- assign c = block.settings.collection -%}
      <div class="tab-panel" id="Panel-{{ block.id }}" {% if tab_ids.size > 1 %}role="tabpanel" aria-labelledby="Tab-{{ block.id }}"{% endif %} {% unless panel_index == 0 %}hidden{% endunless %}>
        <ul class="product-grid product-grid--row" role="list">
          {%- for product in c.products limit: limit -%}
            <li>{%- render 'product-card', product: product -%}</li>
          {%- endfor -%}
        </ul>
        <p class="section-cta"><a href="{{ c.url }}" class="button button--secondary">View all {{ block.settings.label | default: c.title | escape }} {% render 'icon', name: 'arrow' %}</a></p>
      </div>
      {%- assign panel_index = panel_index | plus: 1 -%}
    {%- endfor -%}
  </div>
</section>
{%- elsif collections.all.products_count > 0 -%}
{%- comment -%} None of the chosen collections exist yet: show products from the whole shop. {%- endcomment -%}
<section class="section section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container">
    <div class="section-head"><h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <ul class="product-grid product-grid--row" role="list">
      {%- for product in collections.all.products limit: limit -%}
        {%- if product.available -%}<li>{%- render 'product-card', product: product -%}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    <p class="section-cta"><a href="{{ routes.all_products_collection_url }}" class="button button--secondary">Shop all products {% render 'icon', name: 'arrow' %}</a></p>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Today's finds" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 4, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }],
      "default": "paper"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Best Bargains" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Tabs with an empty collection are hidden." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        { "type": "tab", "settings": { "label": "Best Bargains" } },
        { "type": "tab", "settings": { "label": "New Arrivals" } }
      ]
    }
  ]
}
{% endschema %}
