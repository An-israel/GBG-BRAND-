<section class="section contact" aria-labelledby="Title-{{ section.id }}">
  <div class="container contact__grid">
    <div class="contact__details">
      <h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if settings.response_time != blank -%}
        <p class="contact__promise">{% render 'icon', name: 'clock' %} {{ settings.response_time | escape }}</p>
      {%- elsif request.design_mode -%}
        <p class="placeholder-note">[TO CONFIRM] Add the reply-time promise in Theme settings → Shop details.</p>
      {%- endif -%}
      <ul class="contact__list" role="list">
        <li>{% render 'icon', name: 'phone' %} <a href="tel:+{{ settings.phone_international }}" data-track="contact">{{ settings.phone | escape }}</a></li>
        {%- if settings.whatsapp_enabled -%}
          <li>{% render 'icon', name: 'whatsapp' %} <a href="https://wa.me/{{ settings.phone_international }}" target="_blank" rel="noopener" data-track="whatsapp_click">WhatsApp {{ settings.phone | escape }}</a></li>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <li>{% render 'icon', name: 'mail' %} <a href="mailto:{{ settings.email }}" data-track="contact">{{ settings.email | escape }}</a></li>
        {%- endif -%}
        <li>{% render 'icon', name: 'pin' %} {% render 'address' %}</li>
      </ul>
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{% render 'icon', name: 'check' %} Thanks for your message. We'll get back to you{% if settings.response_time != blank %} – {{ settings.response_time | escape | downcase }}{% else %} as soon as we can{% endif %}.</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
          <p>Please check the form:</p>
          <ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul>
        </div>
      {%- endif -%}
      <div class="field">
        <label for="ContactName">Name</label>
        <input class="input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
        <input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email | default: customer.email }}">
      </div>
      <div class="field">
        <label for="ContactPhone">Phone (optional)</label>
        <input class="input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label for="ContactOrder">Order number (if you have one)</label>
        <input class="input" id="ContactOrder" type="text" name="contact[order_number]" value="{{ form.order_number }}">
      </div>
      <div class="field">
        <label for="ContactBody">Message <span aria-hidden="true">*</span></label>
        <textarea class="input" id="ContactBody" name="contact[body]" rows="6" required aria-required="true">{{ form.body }}</textarea>
      </div>
      <p class="field__hint">We use your details only to reply to your message. See our <a href="{{ shop.privacy_policy.url | default: routes.root_url }}">privacy policy</a>.</p>
      <button type="submit" class="button button--large">Send message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
