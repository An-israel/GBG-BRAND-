{%- comment -%} FAQ accordion with FAQPage structured data. {%- endcomment -%}
<section class="section faq section--{{ section.settings.background }}" aria-labelledby="Title-{{ section.id }}">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title" id="Title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__q">{{ block.settings.question | escape }} {% render 'icon', name: 'chevron' %}</summary>
          <div class="accordion__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQs",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [{ "value": "white", "label": "White" }, { "value": "paper", "label": "Paper" }],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer [FOR APPROVAL]</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQs", "blocks": [{ "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
