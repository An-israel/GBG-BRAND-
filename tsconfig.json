{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
